# Frontend (safe in the browser)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_EXTRACT_API_URL=https://my-cloud-player-api.onrender.com/api/json
# VITE_YOUTUBE_API_KEY=

# Force Netlify long-session auth locally (needs `netlify dev`)
# VITE_USE_NETLIFY_AUTH=true

# Backend / Netlify Functions only (NEVER use VITE_ prefix for secrets)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
SESSION_SECRET=invent-a-long-random-string
