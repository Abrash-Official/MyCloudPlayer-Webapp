# Google OAuth Web Client ID (Google Cloud Console → APIs & Services → Credentials)
# Must be an OAuth 2.0 Web application client.
# Add authorized JavaScript origins: http://localhost:5173 (and your production URL)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional default YouTube Data API v3 key (users can also set one in Settings)
# VITE_YOUTUBE_API_KEY=

# Cobalt-compatible audio extraction API
VITE_EXTRACT_API_URL=https://my-cloud-player-api.onrender.com/api/json
